# Copy to apps/web/.env.local. Leave NEXT_PUBLIC_SUPABASE_URL unset to run on sample data (demo mode).

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client (the same one configured in Supabase > Auth > Providers > Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes for encrypting Gmail refresh tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Claude API (or run `ant auth login` locally and leave this unset)
ANTHROPIC_API_KEY=
# Optional per-task model overrides; all default to claude-opus-5.
# FLOSSAMER_MODEL_CLASSIFY=
# FLOSSAMER_MODEL_EXTRACT=
# FLOSSAMER_MODEL_DRAFT=
# FLOSSAMER_MODEL_VOICE=

# Inngest. Locally: INNGEST_DEV=1 and run `npx inngest-cli@latest dev`. In production: keys from the Inngest dashboard.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Public URL, used as the OAuth redirect fallback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
