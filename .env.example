# Copy to apps/web/.env.local. Leave DATABASE_URL unset to run on sample data (demo mode).

# Neon Postgres. The app uses the pooled URL; migrations use the direct one:
#   DATABASE_URL=<direct url> npm run db:migrate
DATABASE_URL=

# Auth.js. AUTH_SECRET: npx auth secret (or openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (Web application). Also used by background jobs to refresh Gmail access.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 32 random bytes for encrypting Gmail refresh tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Claude API (or run `ant auth login` locally and leave this unset)
ANTHROPIC_API_KEY=
# Optional per-task model overrides; all default to claude-opus-5.
# FLOSSAMER_MODEL_CLASSIFY=
# FLOSSAMER_MODEL_EXTRACT=
# FLOSSAMER_MODEL_DRAFT=
# FLOSSAMER_MODEL_VOICE=

# Inngest. Locally: INNGEST_DEV=1 and run `npx inngest-cli@latest dev`. In production: keys from the Inngest dashboard.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
